<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<OutputType>Exe</OutputType>
		<ImplicitUsings>enable</ImplicitUsings>
		<OutDir>$(OutputPath)</OutDir>
	</PropertyGroup>

	<ItemGroup>
	  <None Remove="appsettings.json" />
	  <None Remove="Views\Shared\_Layout.cshtml" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="HtmlTags" Version="9.0.0" />
	  <PackageReference Include="Microsoft.AspNetCore.Authentication.Abstractions" Version="2.3.0" />
	  <PackageReference Include="Microsoft.AspNetCore.Authentication.Cookies" Version="2.3.0" />
	  <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="9.0.7" />
	  <PackageReference Include="Microsoft.AspNetCore.Mvc.Core" Version="2.3.0" />
	  <PackageReference Include="Microsoft.AspNetCore.Mvc.TagHelpers" Version="2.3.0" />
	  <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.7">
	    <PrivateAssets>all</PrivateAssets>
	    <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	  </PackageReference>
	  <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.7" />
		<PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="9.0.7" />

	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\WhatsAppCRM.Application\WhatsAppCRM.Application.csproj" />
	  <ProjectReference Include="..\WhatsAppCRM.Infrastructure\WhatsAppCRM.Infrastructure.csproj" />
	</ItemGroup>

	<ItemGroup>
		
		
	  <Folder Include="Views\Account\" />
		
	  <Folder Include="Views\Dashboard\" />
		
	  <Folder Include="Views\Settings\" />
		
	  <Folder Include="Views\Template\" />

		
	  <Folder Include="Views\Reports\" />
		
	  <Folder Include="Views\WebhookTest\" />
	</ItemGroup>
</Project>