@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var latestMessages = ViewBag.LatestMessages as List<WhatsAppCRM.Domain.Entities.Message>;
}
<h2>Dashboard</h2>
<div class="row">
    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-body">
                <h5>Total Customers</h5>
                <p class="display-6">@ViewBag.TotalCustomers</p>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-body">
                <h5>Total Messages</h5>
                <p class="display-6">@ViewBag.TotalMessages</p>
            </div>
        </div>
    </div>
</div>
<div class="card">
    <div class="card-header">
        <h5>Latest Messages</h5>
    </div>
    <div class="card-body">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>To</th>
                    <th>Content</th>
                    <th>Time</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var message in latestMessages ?? new List<WhatsAppCRM.Domain.Entities.Message>())
                {
                    <tr>
@*                         <td>@message.PhoneNumber</td>
 *@                        <td>@message.TextContent</td>
                        <td>@message.Timestamp.ToString("g")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>