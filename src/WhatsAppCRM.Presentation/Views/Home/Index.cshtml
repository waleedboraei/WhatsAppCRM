@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="mb-4">📊 Dashboard</h2>
<div class="row">
    <div class="col-md-3">
        <div class="card text-white bg-primary mb-3">
            <div class="card-header">Total Customers</div>
            <div class="card-body">
                <h5 class="card-title">@ViewBag.TotalCustomers</h5>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-success mb-3">
            <div class="card-header">Total Messages</div>
            <div class="card-body">
                <h5 class="card-title">@ViewBag.TotalMessages</h5>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-warning mb-3">
            <div class="card-header">Active Webhooks</div>
            <div class="card-body">
                <h5 class="card-title">@ViewBag.ActiveWebhooks</h5>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-info mb-3">
            <div class="card-header">Pending Templates</div>
            <div class="card-body">
                <h5 class="card-title">@ViewBag.PendingTemplates</h5>
            </div>
        </div>
    </div>
</div>