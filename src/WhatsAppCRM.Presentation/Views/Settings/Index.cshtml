@model List<WhatsAppCRM.Domain.Entities.Setting>
@{
    ViewData["Title"] = "Settings";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<h2>System Settings</h2>
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
<form asp-action="Save" method="post">
    <table class="table">
        <thead>
            <tr><th>Key</th><th>Value</th></tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Count; i++)
            {
                <tr>
                    <td>
                        <input type="hidden" name="settings[@i].Key" value="@Model[i].Key" />
                        <strong>@Model[i].Key</strong>
                    </td>
                    <td>
                        <input type="text" name="settings[@i].Value" value="@Model[i].Value" class="form-control" />
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <button type="submit" class="btn btn-success">Save</button>
</form>